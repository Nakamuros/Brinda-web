DB_URL=jdbc:postgresql://localhost:5433/brinda
DB_APP_USER=brinda_app
DB_APP_PASSWORD=
DB_OWNER_USER=brinda_owner
DB_OWNER_PASSWORD=
# Mínimo 32 caracteres, generar con: openssl rand -base64 48
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:4200
COOKIE_SECURE=false
# Proxies propios delante de la API (cuenta desde la derecha de X-Forwarded-For para el límite por IP). Mínimo 1.
# Local sin proxy: 1. PRODUCCIÓN (Render con Cloudflare delante): 2, verificado. Cualquier proxy nuevo obliga a re-verificar (ver avances.md).
TRUSTED_PROXY_HOPS=1
DNI_ENCRYPTION_KEY=
WHATSAPP_NUMBER=51999999999
YAPE_NUMBER=
PLIN_NUMBER=
# Cuenta para pagos por transferencia (vacías = el cliente ve "Te enviaremos los datos de la cuenta por WhatsApp")
TRANSFER_BANK=
TRANSFER_ACCOUNT=
TRANSFER_CCI=
TRANSFER_HOLDER=
# Versión de términos y privacidad que se guarda en cada pedido (fecha de LEGAL.documentsUpdatedAt). Vacía hasta el lanzamiento.
LEGAL_DOCUMENTS_VERSION=
# Tope en soles del delivery cobrado al confirmar un pedido (por defecto 100)
# MAX_DELIVERY_FEE=100
# Prefijo de las imágenes con ruta relativa en image_url (ej. https://img.midominio.com). Vacío = ruta tal cual
IMAGES_BASE_URL=
# Carpeta de las fotos subidas desde el panel (por defecto ./uploads) y su URL pública si la API va en otro dominio
IMAGES_UPLOAD_DIR=
IMAGES_PUBLIC_URL=
# Correo de la dueña para avisarle de cada reclamo nuevo (vacío = sin aviso). El servicio de correo real aún no está conectado.
COMPLAINTS_OWNER_EMAIL=
